{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabletop",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BoardRoom",
        "class_name": "BoardRoom"
      },
      {
        "name": "Limiter",
        "class_name": "Limiter"
      }
    ]
  },
  "exports": {
    "BoardRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Limiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "TABLETOP_MODE": "hosted",
    "ISSUER": "dev-host",
    "HOST_ORIGIN": "http://localhost:8000"
  },
  "secrets": {
    "required": ["ISSUER_PUBLIC_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabletop",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
}
