{
  "name": "littletable-top",
  "version": "0.1.0",
  "private": true,
  "description": "A shared tldraw whiteboard for tabletop RPGs",
  "files": [
    "alchemy",
    "client",
    "dev",
    "migrations",
    "src",
    "tsconfig.json",
    "vite.config.ts",
    "wrangler.json"
  ],
  "type": "module",
  "exports": {
    "./alchemy": {
      "types": "./alchemy/index.d.ts",
      "default": "./alchemy/index.js"
    },
    "./dev-signing-key.pem": "./dev/dev-signing-key.pem",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:worker": "mkdir -p dist && wrangler dev --port 8789",
    "serve": "wrangler dev --port 8788",
    "plan:prod": "alchemy plan --stage prod",
    "deploy:prod": "alchemy deploy --stage prod",
    "plan:staging": "alchemy plan --stage staging",
    "deploy:staging": "alchemy deploy --stage staging",
    "lint": "bun scripts/lint.ts",
    "doctor": "react-doctor --yes --no-telemetry --no-supply-chain",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client && tsc --noEmit -p e2e",
    "build:workers": "wrangler deploy --dry-run --outdir .wrangler/dry/board && wrangler deploy --dry-run -c wrangler.mcp.json --outdir .wrangler/dry/mcp",
    "serve:mcp": "wrangler dev -c wrangler.dev.json -c wrangler.json -c wrangler.mcp.json --port 8788",
    "e2e:measure": "playwright test -c e2e/measure.config.ts && oxfmt --write test/mcp/fixtures"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@cf-wasm/photon": "0.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.2.4",
    "@tldraw/assets": "5.6.2",
    "@tldraw/sync": "5.6.2",
    "@tldraw/sync-core": "5.6.2",
    "@tldraw/tlschema": "5.6.2",
    "@tldraw/utils": "5.6.2",
    "@tldraw/validate": "5.6.2",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cuelume": "0.2.8",
    "fontkit": "2.0.4",
    "jose": "6.2.3",
    "minisearch": "7.2.0",
    "onnxruntime-web": "1.31.1",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.1.16",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2",
    "tldraw": "5.6.2",
    "unique-names-generator": "4.7.1",
    "vite": "8.1.6",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/github": "2.0.0-beta.85",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@effect/platform-node": "4.1.2",
    "@hasparus/oxlint-config": "file:vendor/oxlint/hasparus-oxlint-config-0.5.0.tgz",
    "@playwright/test": "1.65.0",
    "@shadcn/lint": "0.2.5",
    "@types/babel__core": "7.20.5",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "oxfmt": "0.56.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2005",
    "react-doctor": "0.9.23",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "wrangler": "4.145.0"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
