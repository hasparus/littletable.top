{
  "name": "littletable-top",
  "version": "0.1.0",
  "private": true,
  "description": "A shared tldraw whiteboard with dice, as a Cloudflare Worker a host can deploy or run on its own",
  "files": [
    "alchemy",
    "client",
    "dev",
    "migrations",
    "src",
    "tsconfig.json",
    "vite.config.ts",
    "wrangler.json"
  ],
  "type": "module",
  "exports": {
    "./alchemy": {
      "types": "./alchemy/index.d.ts",
      "default": "./alchemy/index.js"
    },
    "./dev-signing-key.pem": "./dev/dev-signing-key.pem",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:worker": "mkdir -p dist && wrangler dev --port 8789",
    "serve": "wrangler dev --port 8788",
    "plan:prod": "alchemy plan --stage prod",
    "deploy:prod": "alchemy deploy --stage prod",
    "plan:staging": "alchemy plan --stage staging",
    "deploy:staging": "alchemy deploy --stage staging",
    "lint": "oxlint -c oxlint.config.ts --max-warnings 0 client src alchemy e2e",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@tldraw/assets": "5.6.0",
    "@tldraw/sync": "5.6.0",
    "@tldraw/sync-core": "5.6.0",
    "@tldraw/tlschema": "5.6.0",
    "@tldraw/utils": "5.6.0",
    "jose": "6.2.3",
    "minisearch": "7.2.0",
    "onnxruntime-web": "1.31.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.1.16",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2",
    "tldraw": "5.6.0",
    "vite": "8.1.6"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/github": "2.0.0-beta.85",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@effect/platform-node": "4.1.2",
    "@hasparus/oxlint-config": "0.3.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "oxfmt": "0.56.0",
    "oxlint": "1.70.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "wrangler": "4.145.0"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
