{
  "name": "littletable-opennext-experiment",
  "main": "worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "TABLETOP",
      "service": "tabletop",
    },
  ],
}
