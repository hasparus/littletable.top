{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabletop-mcp",
  "main": "src/mcp/worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "BoardRoom",
        "class_name": "BoardRoom",
        "script_name": "tabletop"
      }
    ]
  },
  "vars": {
    "ISSUER": "dev-host",
    "MCP_AUTHORIZATION_SERVER": "http://localhost:8000"
  }
}
